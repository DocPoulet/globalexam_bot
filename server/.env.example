# Copie vers server/.env. Ne jamais committer ce fichier ni une vraie clé.
# Mot de passe alphanumérique long; éviter les caractères à encoder dans une URL.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
# Écritures BLOQUÉES tant que droits/consentement/modération non validés.
COMMUNITY_WRITES_ENABLED=false
COMMUNITY_MIN_CONFIRMATIONS=3
COMMUNITY_READ_LIMIT_DAY=500
COMMUNITY_WRITE_LIMIT_DAY=200

# Local Docker Compose uniquement. Railway fournit PORT et DATABASE_URL.
# Ne mets jamais DATABASE_URL / mots de passe réels ici ou dans Git.

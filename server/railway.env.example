# Exemple DOCUMENTAIRE pour le service API dans Railway -> Variables.
# Ne pas importer avec valeurs réelles dans un dépôt public.
# Référence Railway : choisir le service PostgreSQL depuis l'éditeur
# des variables (son nom doit correspondre, souvent "Postgres").
DATABASE_URL=${{Postgres.DATABASE_URL}}
COMMUNITY_WRITES_ENABLED=false
COMMUNITY_MIN_CONFIRMATIONS=3
COMMUNITY_READ_LIMIT_DAY=500
COMMUNITY_WRITE_LIMIT_DAY=200
# PORT est injecté automatiquement par Railway.
